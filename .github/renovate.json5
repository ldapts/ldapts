{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices', ':semanticCommits'],
  timezone: 'America/Chicago',
  labels: ['dependencies'],
  rangeStrategy: 'pin',
  automerge: true,
  automergeType: 'pr',
  osvVulnerabilityAlerts: true,
  postUpdateOptions: ['pnpmDedupe'],
  packageRules: [
    {
      matchDepTypes: ['peerDependencies'],
      enabled: false,
    },
    {
      matchDepTypes: ['engines'],
      rangeStrategy: 'replace',
    },
    {
      matchPackageNames: ['@types/node', '@types/asn1'],
      rangeStrategy: 'replace',
    },
    {
      matchDepTypes: ['devDependencies'],
      schedule: ['* 0-4,22-23 * * 1-5', '* * * * 0,6'],
      groupName: 'dev dependencies',
      semanticCommitType: 'chore',
    },
    {
      // vite-plus pins an exact @voidzero-dev/vite-plus-core, which the `vite` catalog alias must match
      matchPackageNames: ['vite-plus', '@voidzero-dev/vite-plus-core'],
      groupName: 'vite-plus',
      separateMajorMinor: false,
    },
    {
      matchDepTypes: ['dependencies'],
      groupName: 'all dependencies',
      semanticCommitType: 'fix',
    },
  ],
}
